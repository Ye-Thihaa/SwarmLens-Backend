CONSOLE_PASSWORD=change-me
OPERATOR_TOKEN=change-me

# Where the guest app looks for the backend nodes.
# Leave unset for desktop dev: it defaults to the absolute 127.0.0.1:8001-8003
# URLs in src/lib/api.ts.
# Set to the dev server's proxy paths when testing on a phone over HTTPS --
# an HTTPS page can't call http:// (mixed content), and 127.0.0.1 on a phone
# means the phone itself. See the proxy block in vite.config.ts.
# VITE_NODE_URLS=/n1,/n2,/n3
